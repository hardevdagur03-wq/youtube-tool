{"dashboard": {"title": "System Overview", "editable": true, "tags": ["production", "monitoring"], "timezone": "utc", "panels": [
  {"id": 1, "title": "CPU Usage", "type": "gauge", "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}, "targets": [{"expr": "yt_blog_cpu_usage", "legendFormat": "CPU"}], "options": {"orientation": "auto", "show": "all", "reduceOptions": {"calcs": ["lastNotNull"]}}},
  {"id": 2, "title": "Memory Usage", "type": "gauge", "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}, "targets": [{"expr": "yt_blog_memory_usage", "legendFormat": "Memory"}], "options": {"orientation": "auto", "show": "all", "reduceOptions": {"calcs": ["lastNotNull"]}}},
  {"id": 3, "title": "Disk Usage", "type": "gauge", "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}, "targets": [{"expr": "yt_blog_disk_usage", "legendFormat": "Disk"}], "options": {"orientation": "auto", "show": "all", "reduceOptions": {"calcs": ["lastNotNull"]}}},
  {"id": 4, "title": "Uptime", "type": "stat", "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}, "targets": [{"expr": "time() - process_start_time_seconds", "legendFormat": "Uptime"}], "options": {"colorMode": "none", "graphMode": "none", "textMode": "auto"}},
  {"id": 5, "title": "Active Jobs", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "yt_blog_active_jobs", "legendFormat": "{{type}}"}], "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "table", "placement": "bottom"}}},
  {"id": 6, "title": "Error Rate", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "rate(yt_blog_errors_total[5m])", "legendFormat": "{{error_type}}"}], "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "table", "placement": "bottom"}}},
  {"id": 7, "title": "API Throughput", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "targets": [{"expr": "rate(yt_blog_api_requests_total[5m])", "legendFormat": "{{endpoint}}"}], "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "table", "placement": "bottom"}}},
  {"id": 8, "title": "Pipeline Success Rate", "type": "stat", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "targets": [{"expr": "sum(rate(yt_blog_pipeline_completed_total[1h])) / sum(rate(yt_blog_pipeline_started_total[1h]))", "legendFormat": "Success Rate"}], "options": {"colorMode": "thresholds", "graphMode": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.95}, {"color": "green", "value": 0.99}]}}}
], "schemaVersion": 36, "version": 1, "links": [], "refresh": "30s"}}
