{
  "title": "YouTube SEO Platform - Operations Dashboard",
  "uid": "operations",
  "tags": ["youtube-seo", "operations"],
  "timezone": "browser",
  "panels": [
    {
      "title": "Service Health",
      "type": "table",
      "targets": [{"expr": "youtube_seo_health_status"}]
    },
    {
      "title": "CPU Usage",
      "type": "graph",
      "targets": [{"expr": "youtube_seo_cpu_percent{job=\"youtube-seo\"}"}]
    },
    {
      "title": "Memory Usage",
      "type": "graph",
      "targets": [{"expr": "youtube_seo_memory_percent{job=\"youtube-seo\"}"}]
    },
    {
      "title": "Disk Usage",
      "type": "graph",
      "targets": [{"expr": "youtube_seo_disk_percent{job=\"youtube-seo\"}"}]
    },
    {
      "title": "Worker Queue Depth",
      "type": "graph",
      "targets": [{"expr": "youtube_seo_queue_depth{job=\"youtube-seo\"}"}]
    },
    {
      "title": "Worker Status",
      "type": "table",
      "targets": [{"expr": "youtube_seo_worker_status{job=\"youtube-seo\"}"}]
    },
    {
      "title": "Database Connections",
      "type": "graph",
      "targets": [{"expr": "youtube_seo_db_connections{job=\"youtube-seo\"}"}]
    },
    {
      "title": "Redis Memory",
      "type": "graph",
      "targets": [{"expr": "youtube_seo_redis_memory_bytes{job=\"youtube-seo\"}"}]
    }
  ]
}
