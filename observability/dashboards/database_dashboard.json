{
  "title": "YouTube SEO Platform - Database Dashboard",
  "uid": "database",
  "tags": ["youtube-seo", "database"],
  "timezone": "browser",
  "panels": [
    {
      "title": "Active Connections",
      "type": "graph",
      "targets": [{"expr": "youtube_seo_db_connections"}]
    },
    {
      "title": "Query Rate",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_db_queries_total[5m])"}]
    },
    {
      "title": "Slow Queries (>1s)",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_db_slow_queries_total[5m])"}]
    },
    {
      "title": "Average Query Duration",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_db_query_duration_seconds_sum[5m]) / rate(youtube_seo_db_query_duration_seconds_count[5m])"}]
    },
    {
      "title": "Transaction Rate",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_db_transactions_total[5m])"}]
    },
    {
      "title": "Pool Utilization",
      "type": "gauge",
      "targets": [{"expr": "youtube_seo_db_pool_utilization"}]
    }
  ]
}
