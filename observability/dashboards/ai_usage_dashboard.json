{
  "title": "YouTube SEO Platform - AI Usage Dashboard",
  "uid": "ai-usage",
  "tags": ["youtube-seo", "ai"],
  "timezone": "browser",
  "panels": [
    {
      "title": "LLM Calls per Minute",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_llm_calls_total[5m])"}]
    },
    {
      "title": "Token Usage by Model",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_token_total[5m])"}]
    },
    {
      "title": "LLM Latency (P95)",
      "type": "graph",
      "targets": [{"expr": "histogram_quantile(0.95, rate(youtube_seo_llm_duration_seconds_bucket[5m]))"}]
    },
    {
      "title": "Token Cost per Day",
      "type": "graph",
      "targets": [{"expr": "youtube_seo_cost_daily{job=\"youtube-seo\"}"}]
    },
    {
      "title": "Prompt Execution Count",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_prompt_executions_total[5m])"}]
    },
    {
      "title": "Cache Hit Rate for AI Calls",
      "type": "gauge",
      "targets": [{"expr": "rate(youtube_seo_llm_cache_hits_total[5m]) / (rate(youtube_seo_llm_cache_hits_total[5m]) + rate(youtube_seo_llm_calls_total[5m])) * 100"}]
    },
    {
      "title": "Model Distribution",
      "type": "pie",
      "targets": [{"expr": "youtube_seo_llm_calls_total"}]
    },
    {
      "title": "Retry Rate",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_llm_retries_total[5m])"}]
    }
  ]
}
