{
  "title": "YouTube SEO Platform - Cache Dashboard",
  "uid": "cache",
  "tags": ["youtube-seo", "cache"],
  "timezone": "browser",
  "panels": [
    {
      "title": "Cache Hit Rate",
      "type": "gauge",
      "targets": [{"expr": "rate(youtube_seo_cache_hits_total[5m]) / (rate(youtube_seo_cache_hits_total[5m]) + rate(youtube_seo_cache_misses_total[5m])) * 100"}]
    },
    {
      "title": "Cache Lookup Rate",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_cache_lookups_total[5m])"}]
    },
    {
      "title": "Cache Evictions",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_cache_evictions_total[5m])"}]
    },
    {
      "title": "Average Lookup Time",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_cache_lookup_duration_seconds_sum[5m]) / rate(youtube_seo_cache_lookup_duration_seconds_count[5m])"}]
    },
    {
      "title": "Memory Usage",
      "type": "graph",
      "targets": [{"expr": "youtube_seo_cache_memory_bytes / (1024*1024)"}]
    },
    {
      "title": "Cache Type Breakdown",
      "type": "pie",
      "targets": [{"expr": "youtube_seo_cache_entries_total"}]
    }
  ]
}
