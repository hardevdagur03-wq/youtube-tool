{
  "title": "YouTube SEO Platform - Worker Dashboard",
  "uid": "workers",
  "tags": ["youtube-seo", "workers"],
  "timezone": "browser",
  "panels": [
    {
      "title": "Active Workers",
      "type": "stat",
      "targets": [{"expr": "youtube_seo_workers_active"}]
    },
    {
      "title": "Idle Workers",
      "type": "stat",
      "targets": [{"expr": "youtube_seo_workers_idle"}]
    },
    {
      "title": "Failed Jobs (24h)",
      "type": "stat",
      "targets": [{"expr": "rate(youtube_seo_jobs_failed_total[24h])"}]
    },
    {
      "title": "Queue Depth by Priority",
      "type": "graph",
      "targets": [{"expr": "youtube_seo_queue_depth"}]
    },
    {
      "title": "Worker CPU Usage",
      "type": "graph",
      "targets": [{"expr": "youtube_seo_worker_cpu_percent"}]
    },
    {
      "title": "Worker Memory Usage",
      "type": "graph",
      "targets": [{"expr": "youtube_seo_worker_memory_bytes / (1024*1024)"}]
    },
    {
      "title": "Dead Letter Queue Size",
      "type": "stat",
      "targets": [{"expr": "youtube_seo_dead_letter_queue_size"}]
    },
    {
      "title": "Job Retry Rate",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_job_retries_total[5m])"}]
    }
  ]
}
