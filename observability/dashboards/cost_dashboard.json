{
  "title": "YouTube SEO Platform - Cost Dashboard",
  "uid": "cost",
  "tags": ["youtube-seo", "cost"],
  "timezone": "browser",
  "panels": [
    {
      "title": "Total Cost (All Time)",
      "type": "stat",
      "targets": [{"expr": "youtube_seo_cost_total"}]
    },
    {
      "title": "Cost by Service",
      "type": "pie",
      "targets": [{"expr": "youtube_seo_cost_by_service"}]
    },
    {
      "title": "Daily Cost Trend",
      "type": "graph",
      "targets": [{"expr": "youtube_seo_cost_daily"}]
    },
    {
      "title": "Cost by Project",
      "type": "table",
      "targets": [{"expr": "youtube_seo_cost_by_project"}]
    },
    {
      "title": "Cost by Model",
      "type": "table",
      "targets": [{"expr": "youtube_seo_cost_by_model"}]
    },
    {
      "title": "Estimated Monthly Cost",
      "type": "stat",
      "targets": [{"expr": "youtube_seo_cost_monthly_estimate"}]
    },
    {
      "title": "Cost per User",
      "type": "table",
      "targets": [{"expr": "topk(10, youtube_seo_cost_by_user)"}]
    },
    {
      "title": "Cache Savings",
      "type": "stat",
      "targets": [{"expr": "youtube_seo_cache_savings_cost"}]
    }
  ]
}
