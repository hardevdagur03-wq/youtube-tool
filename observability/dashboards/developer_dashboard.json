{
  "title": "YouTube SEO Platform - Developer Dashboard",
  "uid": "developer",
  "tags": ["youtube-seo", "developer"],
  "timezone": "browser",
  "panels": [
    {
      "title": "HTTP Request Duration (P95)",
      "type": "graph",
      "targets": [{"expr": "histogram_quantile(0.95, rate(youtube_seo_http_request_duration_seconds_bucket[5m]))"}]
    },
    {
      "title": "Slow Endpoints",
      "type": "table",
      "targets": [{"expr": "topk(10, youtube_seo_http_request_duration_seconds_sum / youtube_seo_http_request_duration_seconds_count)"}]
    },
    {
      "title": "Error Rate by Status Code",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_http_errors_total[5m])"}]
    },
    {
      "title": "Database Query Duration",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_db_query_duration_seconds_sum[5m]) / rate(youtube_seo_db_query_duration_seconds_count[5m])"}]
    },
    {
      "title": "Cache Hit Rate",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_cache_hits_total[5m]) / (rate(youtube_seo_cache_hits_total[5m]) + rate(youtube_seo_cache_misses_total[5m])) * 100"}]
    },
    {
      "title": "Top Error Types",
      "type": "table",
      "targets": [{"expr": "topk(10, youtube_seo_errors_total)}"]}]
    },
    {
      "title": "Function Call Duration",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_func_duration_seconds_sum[5m]) / rate(youtube_seo_func_duration_seconds_count[5m])"}]
    },
    {
      "title": "Goroutine / Thread Count",
      "type": "graph",
      "targets": [{"expr": "youtube_seo_threads_total"}]
    }
  ]
}
