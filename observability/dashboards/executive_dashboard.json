{
  "title": "YouTube SEO Platform - Executive Dashboard",
  "uid": "executive",
  "tags": ["youtube-seo", "executive"],
  "timezone": "browser",
  "panels": [
    {
      "title": "System Health",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{"expr": "youtube_seo_health_status{job=\"youtube-seo\"}"}]
    },
    {
      "title": "Active Projects",
      "type": "stat",
      "targets": [{"expr": "youtube_seo_projects_active_total{job=\"youtube-seo\"}"}]
    },
    {
      "title": "Pipeline Success Rate (24h)",
      "type": "gauge",
      "targets": [{"expr": "rate(youtube_seo_pipeline_success_total[24h]) / (rate(youtube_seo_pipeline_success_total[24h]) + rate(youtube_seo_pipeline_failure_total[24h])) * 100"}]
    },
    {
      "title": "Total API Cost (30d)",
      "type": "stat",
      "targets": [{"expr": "youtube_seo_cost_total{job=\"youtube-seo\"}"}]
    },
    {
      "title": "Requests per Second",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_http_requests_total[5m])"}]
    },
    {
      "title": "Error Rate by Endpoint",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_http_errors_total[5m])"}]
    },
    {
      "title": "Token Usage (7d)",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_token_total[5m])"}]
    },
    {
      "title": "Active Workers",
      "type": "stat",
      "targets": [{"expr": "youtube_seo_workers_active{job=\"youtube-seo\"}"}]
    }
  ]
}
