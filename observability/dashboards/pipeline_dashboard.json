{
  "title": "YouTube SEO Platform - Pipeline Dashboard",
  "uid": "pipeline",
  "tags": ["youtube-seo", "pipeline"],
  "timezone": "browser",
  "panels": [
    {
      "title": "Pipeline Runs (24h)",
      "type": "stat",
      "targets": [{"expr": "rate(youtube_seo_pipeline_runs_total[24h])"}]
    },
    {
      "title": "Pipeline Success Rate",
      "type": "gauge",
      "targets": [{"expr": "rate(youtube_seo_pipeline_success_total[5m]) / (rate(youtube_seo_pipeline_success_total[5m]) + rate(youtube_seo_pipeline_failure_total[5m])) * 100"}]
    },
    {
      "title": "Stage Duration by Stage",
      "type": "graph",
      "targets": [{"expr": "youtube_seo_stage_duration_seconds"}]
    },
    {
      "title": "Retry Count by Stage",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_stage_retries_total[5m])"}]
    },
    {
      "title": "Average Pipeline Runtime",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_pipeline_duration_seconds_sum[5m]) / rate(youtube_seo_pipeline_duration_seconds_count[5m])"}]
    },
    {
      "title": "Queue Time by Priority",
      "type": "graph",
      "targets": [{"expr": "youtube_seo_queue_time_seconds"}]
    },
    {
      "title": "Checkpoint Usage",
      "type": "graph",
      "targets": [{"expr": "rate(youtube_seo_checkpoint_restores_total[5m])"}]
    },
    {
      "title": "Pipeline Failures by Stage",
      "type": "table",
      "targets": [{"expr": "youtube_seo_stage_failures_total"}]
    }
  ]
}
